APP_NAME=OpenShop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=openshop_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_LEVEL=debug
FILESYSTEM_DISK=local

# Chỉ cho demo local: tự đặt tài khoản Admin và mật khẩu mạnh (>= 12 ký tự).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

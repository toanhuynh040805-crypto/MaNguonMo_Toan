  usecase "Tìm kiếm, lọc và phân trang" as UC2
  usecase "Đăng ký tài khoản" as UC3
  usecase "Đăng nhập / đăng xuất" as UC4
  usecase "Quản lý giỏ hàng" as UC5
  usecase "Đặt hàng COD" as UC6
  usecase "Theo dõi đơn hàng cá nhân" as UC7
  usecase "Hủy đơn chờ xác nhận" as UC8
  usecase "Quản lý danh mục (CRUD)" as UC9
  usecase "Quản lý sản phẩm (CRUD)" as UC10
  usecase "Quản lý trạng thái đơn hàng" as UC11
  usecase "Xem thống kê tổng quan" as UC12
  usecase "Cập nhật tài khoản / đổi mật khẩu" as UC13
  usecase "Xuất CSV đơn hàng" as UC14
  usecase "Theo dõi sản phẩm sắp hết hàng" as UC15
  usecase "In phiếu đơn hàng COD" as UC16
  usecase "Xem lịch sử trạng thái đơn" as UC17
